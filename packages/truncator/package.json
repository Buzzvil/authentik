{
    "name": "@goauthentik/truncator",
    "version": "1.0.1",
    "description": "Structure-aware string truncation for display",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/truncator"
    },
    "scripts": {
        "build": "tsc -p .",
        "lint": "eslint --fix .",
        "lint-check": "eslint --max-warnings 0 .",
        "prepare": "tsc -p .",
        "prettier": "prettier --write .",
        "prettier-check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "watch": "tsc -p . --watch"
    },
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./out/index.d.ts",
            "import": "./index.js"
        },
        "./measurer": {
            "types": "./out/lib/measurer.d.ts",
            "import": "./lib/measurer.js"
        },
        "./url": {
            "types": "./out/lib/url.d.ts",
            "import": "./lib/url.js"
        },
        "./hash": {
            "types": "./out/lib/hash.d.ts",
            "import": "./lib/hash.js"
        },
        "./mac-address": {
            "types": "./out/lib/mac-address.d.ts",
            "import": "./lib/mac-address.js"
        },
        "./ip-address": {
            "types": "./out/lib/ip-address.d.ts",
            "import": "./lib/ip-address.js"
        },
        "./email": {
            "types": "./out/lib/email.d.ts",
            "import": "./lib/email.js"
        },
        "./uuid": {
            "types": "./out/lib/uuid.d.ts",
            "import": "./lib/uuid.js"
        },
        "./user-agent": {
            "types": "./out/lib/user-agent.d.ts",
            "import": "./lib/user-agent.js"
        },
        "./string": {
            "types": "./out/lib/string.d.ts",
            "import": "./lib/string.js"
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@goauthentik/prettier-config": "link:../prettier-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "^25.9.4",
        "eslint": "^9.39.4",
        "prettier": "3.8.3",
        "prettier-plugin-packagejson": "^3.0.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.9"
    },
    "files": [
        "./index.js",
        "lib/**/*",
        "out/**/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "ignore"
        },
        "packageManager": {
            "name": "pnpm",
            "version": ">=11.5.1",
            "onFail": "ignore"
        }
    },
    "prettier": "@goauthentik/prettier-config",
    "publishConfig": {
        "access": "public"
    }
}
